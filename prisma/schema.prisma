generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ClassLevel {
  SS1
  SS2
  SS3
}

enum ExamType {
  WAEC
  JAMB
  NECO
  POST_UTME
}

enum UserRole {
  STUDENT
  ADMIN
}

enum CurriculumImportStatus {
  UPLOADED
  EXTRACTING
  EXTRACTED
  EXTRACTION_FAILED
  REVIEWED
  SAVED
}

enum LessonState {
  INTRODUCTION
  ASSESS_PRIOR_KNOWLEDGE
  EXPLAIN_CONCEPT
  EXAMPLE
  CHECK_UNDERSTANDING
  MINI_QUIZ
  COMPLETED
}

enum TutorMessageRole {
  TUTOR
  STUDENT
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  username     String     @unique
  email        String     @unique
  passwordHash String?
  phone        String?
  googleId     String?    @unique
  avatarUrl    String?

  role         UserRole   @default(STUDENT)
  classLevel   ClassLevel @default(SS1)
  examTarget   ExamType?  @default(WAEC)

  country      String?
  state        String?
  institution  String?
  age          String?
  interests    String?
  subjects     String?

  coins        Int        @default(0)
  xp           Int        @default(0)
  maxXp        Int        @default(500)
  level        Int        @default(1)
  badges       Int        @default(0)
  certificates Int        @default(0)
  streak       Int        @default(0)
  questionsAnswered Int   @default(0)
  accuracy     Float      @default(0.0)
  timeSpent    Int        @default(0)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tutorSessions        TutorSession[]
  studentMastery       StudentMastery[]
  dailyActivities      DailyActivity[]
  competitionEntries   CompetitionParticipant[]
}

/// A time-boxed contest ranked by XP earned during its window. Curated/
/// seeded data - there's no admin-authoring UI yet.
model Competition {
  id       String   @id @default(cuid())
  title    String
  subtitle String
  prizes   Json // string[]
  startsAt DateTime
  endsAt   DateTime

  createdAt DateTime @default(now())

  participants CompetitionParticipant[]

  @@index([startsAt, endsAt])
}

/// A student's entry in a competition. `xpAtJoin` snapshots the student's
/// total XP the moment they join, so "XP earned in this competition" is
/// just `currentXp - xpAtJoin` - no separate XP-transaction ledger needed.
model CompetitionParticipant {
  id            String   @id @default(cuid())
  competitionId String
  userId        String
  xpAtJoin      Int      @default(0)
  joinedAt      DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@index([competitionId])
}

/// One row per user per calendar day (Africa/Lagos), tracking how much
/// studying happened that day. Backs the Learn screen's streak strip and
/// "Today's Goal" card, and the user's `streak` counter.
model DailyActivity {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime @db.Date
  questionsAnswered Int      @default(0)
  lessonsStudied    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model BlacklistedToken {
  id        String   @id @default(cuid())
  tokenJti  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenJti])
  @@index([expiresAt])
}

model Subject {
  id           String     @id
  name         String
  icon         String
  color        String
  currentTopic String?
  progress     Float      @default(0.0)
  createdAt    DateTime   @default(now())

  questions        Question[]
  curriculumImports CurriculumImport[]
  curriculumTopics  CurriculumTopic[]
  tutorSessions     TutorSession[]
}

model CurriculumImport {
  id               String                 @id @default(cuid())
  subjectId        String
  classLevel       ClassLevel
  fileName         String
  pageCount        Int?
  rawPages         Json?
  extractedJson    Json?
  validationErrors Json?
  status           CurriculumImportStatus @default(UPLOADED)
  errorMessage     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  CurriculumTopic[]

  @@index([subjectId, classLevel])
}

model CurriculumTopic {
  id         String     @id @default(cuid())
  subjectId  String
  classLevel ClassLevel
  importId   String?

  theme                     String
  learningOutcome           String
  focalCompetence           String
  topic                     String
  performanceObjectives     Json
  content                   Json
  keyCompetenciesAndValues  Json
  learningActivities        Json
  teachingLearningResources Json
  evaluationGuide           Json
  sourcePage                Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  import  CurriculumImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  tutorSessions  TutorSession[]
  studentMastery StudentMastery[]

  @@unique([subjectId, classLevel, theme, topic])
  @@index([subjectId, classLevel])
}

model TutorSession {
  id               String      @id @default(cuid())
  userId           String
  subjectId        String
  classLevel       ClassLevel
  topicId          String
  state            LessonState @default(INTRODUCTION)
  masteryAtStart   Int?
  weakAreasAtStart Json?
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic    CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  messages TutorMessage[]

  @@index([userId, subjectId, classLevel])
}

model TutorMessage {
  id        String            @id @default(cuid())
  sessionId String
  role      TutorMessageRole
  content   String
  blocks    Json?
  stateAt   LessonState

  createdAt DateTime @default(now())

  session TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model StudentMastery {
  id            String     @id @default(cuid())
  userId        String
  subjectId     String
  classLevel    ClassLevel
  topicId       String
  masteryScore  Int        @default(0)
  weakAreas     Json?
  lastStudiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, subjectId, classLevel])
}

model Question {
  id              String         @id @default(cuid())
  subjectId       String
  classLevel      ClassLevel
  questionText    String
  explanation     String?
  difficulty      Int            @default(1)
  correctAnswerId String

  subject         Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  options         AnswerOption[]

  createdAt       DateTime       @default(now())

  @@index([subjectId, classLevel])
}

model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  text       String

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}
