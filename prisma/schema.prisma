// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ClassLevel {
  SS1
  SS2
  SS3
}

enum ExamType {
  WAEC
  JAMB
  NECO
  POST_UTME
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  username     String     @unique
  email        String     @unique
  passwordHash String
  phone        String?

  classLevel   ClassLevel @default(SS1)
  examTarget   ExamType?  @default(WAEC)

  xp           Int        @default(0)
  level        Int        @default(1)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model BlacklistedToken {
  id        String   @id @default(cuid())
  tokenJti  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenJti])
  @@index([expiresAt])
}