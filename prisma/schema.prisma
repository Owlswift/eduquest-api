generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ClassLevel {
  JSS1
  JSS2
  JSS3
  SS1
  SS2
  SS3
}

enum ExamType {
  WAEC
  JAMB
  NECO
  POST_UTME
}

enum UserRole {
  STUDENT
  ADMIN
}

/// Real-world fulfillment (actually sending the airtime/data/etc.) isn't
/// automated - this is a manually-worked queue for whoever runs that,
/// not a payment/vendor integration status.
enum RedemptionStatus {
  PENDING
  /// Checked and being arranged; the coins are already taken.
  APPROVED
  FULFILLED
  REJECTED
  /// The student changed their mind while it was still pending.
  CANCELLED
}

/// Lifecycle of a Challenge (see the Challenge model): PENDING until the
/// opponent picks their own topics and the combined question pool is
/// generated, then ACTIVE while either player still has questions left
/// to answer, then COMPLETED once both have submitted. DECLINED is a
/// dead end the opponent can choose instead of responding.
enum ChallengeStatus {
  PENDING
  DECLINED
  ACTIVE
  COMPLETED
}

enum CurriculumImportStatus {
  UPLOADED
  EXTRACTING
  EXTRACTED
  EXTRACTION_FAILED
  REVIEWED
  SAVED
}

/// What a [LedgerEntry] amount is denominated in.
enum LedgerCurrency {
  XP
  COIN
}

enum QuizSessionStatus {
  OPEN
  SUBMITTED
}

/// Whether students can be served a question. Only PUBLISHED questions are
/// ever issued; RETIRED ones stay in the database so past attempts and
/// reviews keep working.
/// Nigeria's six geopolitical zones, used for regional competitions and rankings.
enum Region {
  NORTH_CENTRAL
  NORTH_EAST
  NORTH_WEST
  SOUTH_EAST
  SOUTH_SOUTH
  SOUTH_WEST
}

enum CompetitionType {
  MINI
  MONTHLY
  STATE
  REGIONAL
  NATIONAL
}

/// How a competition is scored. XP_WINDOW is the original format (ranked by XP
/// earned during the window) and is kept only for competitions created before
/// the rebuild. FIXED_SET has every entrant sit the same questions once.
enum CompetitionFormat {
  XP_WINDOW
  FIXED_SET
}

/// DRAFT -> PUBLISHED -> ACTIVE (starts) -> CLOSED (ends; validation) ->
/// FINALISED (results confirmed) -> ARCHIVED. PUBLISHED/ACTIVE/CLOSED advance
/// with the clock when read; FINALISED and ARCHIVED are admin actions.
enum CompetitionStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
  FINALISED
  ARCHIVED
}

enum EntryStatus {
  ENTERED
  IN_PROGRESS
  COMPLETED
  DISQUALIFIED
}

enum PrizeKind {
  COINS
  AIRTIME
  DATA
  DEVICE
  SCHOLARSHIP
  BOOKS
  CERTIFICATE
  OTHER
}

/// The life of a prize won in a competition. A winner claims it (giving delivery
/// details), an admin verifies the win and then fulfils it; if it is never
/// claimed, or verification fails, it is forfeited and can pass to the next place.
enum PrizeAwardStatus {
  AWAITING_CLAIM
  CLAIMED
  VERIFIED
  FULFILLED
  FORFEITED
  REJECTED
}

enum CertificateKind {
  SUBJECT
  PARTICIPATION
  WINNER
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ExamStatus {
  IN_PROGRESS
  SUBMITTED
}

enum AttemptSource {
  QUIZ
  STARTER
  CHALLENGE
  DAILY
  EXAM
  COMPETITION
}

enum LessonState {
  INTRODUCTION
  ASSESS_PRIOR_KNOWLEDGE
  EXPLAIN_CONCEPT
  EXAMPLE
  CHECK_UNDERSTANDING
  MINI_QUIZ
  COMPLETED
}

enum TutorMessageRole {
  TUTOR
  STUDENT
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  username     String     @unique
  email        String     @unique
  passwordHash String?
  phone        String?
  googleId     String?    @unique
  avatarUrl    String?

  role         UserRole   @default(STUDENT)
  classLevel   ClassLevel @default(SS1)
  examTarget   ExamType?  @default(WAEC)

  country      String?
  state        String?
  institution  String?
  age          String?
  interests    String?
  subjects     String?

  coins        Int        @default(0)
  xp           Int        @default(0)
  maxXp        Int        @default(500)
  level        Int        @default(1)
  badges       Int        @default(0)
  certificates Int        @default(0)
  streak       Int        @default(0)
  /// Highest `streak` ever reached; only ever raised.
  longestStreak Int       @default(0)
  questionsAnswered Int   @default(0)
  accuracy     Float      @default(0.0)
  timeSpent    Int        @default(0)

  /// Set once, atomically, when the welcome bonus is paid out - makes
  /// POST /users/claim-bonus a one-time award.
  welcomeBonusClaimedAt       DateTime?
  /// Set once when the starter challenge is graded and paid out.
  starterChallengeCompletedAt DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  quizSessions         QuizSession[]
  examSessions         ExamSession[]
  ledgerEntries        LedgerEntry[]
  questionAttempts     QuestionAttempt[]
  auditLogs            AdminAuditLog[]
  prizeAwards          PrizeAward[]
  notificationPreference NotificationPreference?
  achievements         UserAchievement[]
  tutorSessions        TutorSession[]
  studentMastery       StudentMastery[]
  dailyActivities      DailyActivity[]
  competitionEntries   CompetitionParticipant[]
  rewardRedemptions    RewardRedemption[]
  passwordResetOtps    PasswordResetOtp[]
  notifications        Notification[]
  deviceTokens         DeviceToken[]
  earnedCertificates   Certificate[]
  challengesSent       Challenge[]              @relation("ChallengesSent")
  challengesReceived   Challenge[]              @relation("ChallengesReceived")
  subjectStats         SubjectStat[]

  // Leaderboards rank students by XP, overall and within a state or class.
  @@index([xp])
  @@index([state, xp])
  @@index([classLevel, xp])
}

/// Append-only record of every XP / coin change. `User.xp` and
/// `User.coins` are running totals of these rows (opening balances for
/// accounts that predate the ledger are stored as `opening_balance`
/// entries). `idempotencyKey` is unique, so a retried or replayed award
/// with the same key can never be applied twice.
model LedgerEntry {
  id             String         @id @default(cuid())
  userId         String
  currency       LedgerCurrency
  /// Positive = credit, negative = debit.
  amount         Int
  reason         String
  refType        String?
  refId          String?
  idempotencyKey String         @unique

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, currency, createdAt])
  @@index([userId, reason, createdAt])
}

/// Who changed what in the admin tools (PRODUCT.md section 17.1). Append-only.
/// `before`/`after` hold a compact snapshot of the changed fields.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  entityType String
  entityId   String
  summary    String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([adminId, createdAt])
}

/// One graded answer to one question, kept for history and analytics
/// (topic accuracy, weak topics, exam review). Written when a session,
/// challenge or exam is graded. `selectedOptionId` is null when the question
/// was left unanswered. `subjectId` and `topic` are copied from the question
/// so analytics don't need a join.
model QuestionAttempt {
  id               String        @id @default(cuid())
  userId           String
  questionId       String
  subjectId        String
  topic            String?
  selectedOptionId String?
  correct          Boolean
  source           AttemptSource
  /// Id of the session / challenge / exam this answer belongs to.
  sourceRefId      String
  createdAt        DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceRefId, questionId])
  @@index([userId, subjectId, createdAt])
  @@index([userId, subjectId, topic])
  @@index([questionId])
  @@index([subjectId, createdAt])
}

/// An achievement a student has unlocked. The catalogue (names, criteria,
/// rewards) lives in code (`achievements.catalog.ts`); this row is the
/// verified, server-side record that it was earned.
model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  key        String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

/// A server-issued set of quiz questions. Rewards are only ever paid
/// against a session: the client can't choose which questions count, and
/// a session can be submitted exactly once. `answers` holds
/// { [questionId]: selectedOptionId } for questions whose answer was
/// locked in via the per-question check, so a revealed answer can't be
/// changed afterwards.
model QuizSession {
  id          String            @id @default(cuid())
  userId      String
  subjectId   String
  questionIds String[]
  answers     Json              @default("{}")
  status      QuizSessionStatus @default(OPEN)
  /// Number answered correctly; set when the session is graded.
  correctCount Int              @default(0)
  /// Set when this session is a student's attempt at a daily challenge.
  dailyChallengeId String?
  /// Set when this session is a student's sitting of a competition.
  competitionId    String?
  /// Hard deadline for the session (competitions with a time limit).
  expiresAt        DateTime?

  createdAt   DateTime  @default(now())
  submittedAt DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyChallenge DailyChallenge? @relation(fields: [dailyChallengeId], references: [id], onDelete: SetNull)
  competition    Competition?    @relation(fields: [competitionId], references: [id], onDelete: SetNull)

  /// One attempt per student per daily challenge / competition (NULLs, i.e.
  /// ordinary quizzes, never collide).
  @@unique([userId, dailyChallengeId])
  @@unique([userId, competitionId])
  @@index([userId, status])
}

/// The question set every student of a class level gets for one Lagos
/// calendar day. Created on first request (unique on date + class level),
/// so there is no scheduler to fail.
model DailyChallenge {
  id          String     @id @default(cuid())
  date        DateTime   @db.Date
  classLevel  ClassLevel
  questionIds String[]
  createdAt   DateTime   @default(now())

  sessions QuizSession[]

  @@unique([date, classLevel])
}

/// A timed exam simulation. `endsAt` is fixed when it starts and enforced on
/// the server: answers saved or submitted after it (plus a short grace for
/// network lag) are ignored. Awards no XP or coins; it is practice for the
/// real exam (PRODUCT.md section 5.5).
model ExamSession {
  id          String     @id @default(cuid())
  userId      String
  examType    ExamType
  subjectId   String
  questionIds String[]
  durationSec Int
  startedAt   DateTime   @default(now())
  endsAt      DateTime
  submittedAt DateTime?
  status      ExamStatus @default(IN_PROGRESS)
  /// { [questionId]: selectedOptionId }, autosaved while the exam runs.
  answers     Json       @default("{}")
  score       Int?
  /// True when the exam used past questions of the chosen exam body; false
  /// when there were too few and it fell back to the general bank.
  pastQuestionsOnly Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, startedAt])
}


/// Auto-awarded once a student's average StudentMastery score in a
/// subject crosses a threshold across enough topics (see
/// CertificatesService) - not admin-issued, no manual grant path yet.
model Certificate {
  id          String          @id @default(cuid())
  userId      String
  kind        CertificateKind @default(SUBJECT)
  /// Set for SUBJECT certificates.
  subjectId   String?
  /// What the certificate is for, as printed: a subject name or the competition title.
  subjectName String
  /// The headline, e.g. "Lagos State Champion" or "Participant". Null for older subject certificates.
  title       String?
  competitionId String?
  /// Finishing position for WINNER certificates.
  rank        Int?
  /// Public code anyone can check at GET /certificates/verify/:code.
  verificationCode String     @unique
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@unique([userId, competitionId, kind])
  @@index([userId])
}

/// A prize a student won in a competition, from announcement to delivery.
model PrizeAward {
  id            String           @id @default(cuid())
  competitionId String
  prizeId       String
  userId        String
  /// Finishing position that earned it.
  rank          Int
  status        PrizeAwardStatus @default(AWAITING_CLAIM)
  /// After this the prize can be forfeited and passed on.
  claimDeadline DateTime
  claimedAt     DateTime?
  /// What the winner supplied: contact phone, delivery note, guardian contact.
  claimDetails  Json?
  verifiedAt    DateTime?
  verifiedById  String?
  fulfilledAt   DateTime?
  fulfilmentNote String?
  /// Why it was forfeited or rejected.
  closedReason  String?
  /// Set when this award was created by passing on a forfeited one.
  promotedFromId String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  competition Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  prize       CompetitionPrize @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@index([userId])
  @@index([competitionId, status])
  @@index([status, claimDeadline])
}

/// An in-app notification - the bell icon's feed. Created on meaningful
/// events (badge earned, reward redeemed, competition joined, ...) and
/// optionally also pushed via [DeviceToken]s if any are registered.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  read      Boolean  @default(false)
  /// Set for scheduled notifications (e.g. `streak_reminder:<user>:2026-06-15`):
  /// a second attempt with the same key is dropped, so a retried or duplicated
  /// job can never message a student twice.
  dedupeKey String?  @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

/// What a student wants to hear about. Everything is on by default. Messages
/// about money and prizes (reward and prize status) are always delivered.
model NotificationPreference {
  userId         String   @id
  /// Streak reminders and "today's challenge is ready".
  studyReminders Boolean  @default(true)
  /// Competition opening, closing soon and results.
  competitions   Boolean  @default(true)
  /// Badges, levels and certificates.
  achievements   Boolean  @default(true)
  /// Allow push notifications at all; the in-app feed is unaffected.
  push           Boolean  @default(true)
  updatedAt      DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A push token registered by one install of the app. A user can have
/// several (multiple devices) - all get pushed to.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String // 'ios' | 'android'
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A one-time password-reset code, emailed to the user. `codeHash` is
/// hashed the same way as login passwords (argon2) - a 6-digit code has
/// little entropy on its own, so `attempts` caps guesses and `expiresAt`
/// bounds the window regardless.
model PasswordResetOtp {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A reward students can redeem with coins. Editable by admins; `id` is a
/// stable slug so older redemptions still point at it. A redemption keeps its
/// own copy of the title and price, so editing a reward never rewrites history.
model Reward {
  id          String    @id
  title       String
  subtitle    String
  description String?
  coinCost    Int
  /// Units left; null means unlimited.
  stock       Int?
  active      Boolean   @default(true)
  kind        PrizeKind @default(OTHER)
  /// Name of an illustration in the design system's assets.
  imageKey    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([active, sortOrder])
}

/// A record of coins spent on a reward. The catalogue itself (title,
/// cost) is a small fixed list in code, not a DB table - there's no
/// admin-authoring UI for it yet, so nothing to look up.
model RewardRedemption {
  id       String           @id @default(cuid())
  userId   String
  rewardId String
  title    String
  coinCost Int
  status   RedemptionStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  approvedAt  DateTime?
  fulfilledAt DateTime?
  /// When it was closed without delivery (rejected or cancelled).
  closedAt    DateTime?
  /// Admin note shown to the student (why it was rejected, what was sent).
  note        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// A ranked contest. New competitions are FIXED_SET: every entrant sits the
/// same questions once, scored only from that sitting (never from lifetime XP
/// or practice). The rules below are frozen when it is published
/// (PRODUCT.md section 6.3).
model Competition {
  id       String   @id @default(cuid())
  title    String
  subtitle String
  /// Plain-text prize list kept for older clients; the structured prizes are in CompetitionPrize.
  prizes   Json // string[]
  startsAt DateTime
  endsAt   DateTime

  /// Full rules and terms shown to students before they enter.
  description String?
  type        CompetitionType   @default(MONTHLY)
  format      CompetitionFormat @default(XP_WINDOW)
  status      CompetitionStatus @default(PUBLISHED)

  // Eligibility. An empty list means "everyone".
  classLevels ClassLevel[]
  /// Subjects the questions are drawn from (empty = all subjects of the class levels).
  subjectIds  String[]
  /// Required for STATE competitions.
  state       String?
  /// Required for REGIONAL competitions.
  region      Region?

  // Scoring (FIXED_SET).
  questionCount      Int?
  /// Frozen at publish time.
  questionIds        String[]
  pointsPerCorrect   Int       @default(1)
  /// Points lost per wrong answer (an unanswered question costs nothing). 0 = no penalty.
  penaltyPerWrong    Int       @default(0)
  /// Seconds a student has once they start. Null = until the competition closes.
  timeLimitSec       Int?
  /// Paid once on completing the sitting, whatever the rank.
  participationXp    Int       @default(0)
  participationCoins Int       @default(0)
  /// Days a winner has to claim a prize before it can pass to the next place.
  claimDeadlineDays  Int       @default(14)

  publishedAt DateTime?
  finalisedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  participants CompetitionParticipant[]
  prizeList    CompetitionPrize[]
  prizeAwards  PrizeAward[]
  sessions     QuizSession[]

  @@index([startsAt, endsAt])
  @@index([status])
}

/// A prize for a range of finishing positions, e.g. 1st, or 2nd to 3rd.
model CompetitionPrize {
  id            String    @id @default(cuid())
  competitionId String
  positionFrom  Int
  positionTo    Int
  title         String
  kind          PrizeKind @default(OTHER)
  /// For COINS prizes: paid automatically when the award is fulfilled.
  coinAmount    Int?
  sortOrder     Int       @default(0)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  awards      PrizeAward[]

  @@index([competitionId])
}

/// A student's entry in a competition. `xpAtJoin` snapshots the student's
/// total XP the moment they join, so "XP earned in this competition" is
/// just `currentXp - xpAtJoin` - no separate XP-transaction ledger needed.
model CompetitionParticipant {
  id            String      @id @default(cuid())
  competitionId String
  userId        String
  /// Legacy XP_WINDOW competitions only.
  xpAtJoin      Int         @default(0)
  joinedAt      DateTime    @default(now())

  // FIXED_SET results.
  status          EntryStatus @default(ENTERED)
  startedAt       DateTime?
  completedAt     DateTime?
  score           Int?
  correctCount    Int?
  wrongCount      Int?
  timeTakenSec    Int?
  /// Set when the competition is finalised.
  rank            Int?
  /// Machine-raised review flags (e.g. TOO_FAST, SAME_ANSWERS); an admin decides what they mean.
  flags           String[]    @default([])
  /// Fingerprint of the answers given, to spot identical answer sheets.
  answerHash      String?
  disqualifiedReason String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@index([competitionId])
  @@index([competitionId, status, score])
}

/// One row per user per calendar day (Africa/Lagos), tracking how much
/// studying happened that day. Backs the Learn screen's streak strip and
/// "Today's Goal" card, the user's `streak` counter, and weekly/monthly
/// leaderboard periods (sum of `xpEarned` over the window - avoids a
/// full XP-transaction ledger for something only leaderboards need).
model DailyActivity {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime @db.Date
  questionsAnswered Int      @default(0)
  lessonsStudied    Int      @default(0)
  xpEarned          Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

model BlacklistedToken {
  id        String   @id @default(cuid())
  tokenJti  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenJti])
  @@index([expiresAt])
}

model Subject {
  id           String     @id
  name         String
  icon         String
  color        String
  currentTopic String?
  progress     Float      @default(0.0)
  createdAt    DateTime   @default(now())

  questions        Question[]
  theoryQuestions  TheoryQuestion[]
  curriculumImports CurriculumImport[]
  curriculumTopics  CurriculumTopic[]
  tutorSessions     TutorSession[]
  challenges        Challenge[]
}

model CurriculumImport {
  id               String                 @id @default(cuid())
  subjectId        String
  classLevel       ClassLevel
  fileName         String
  pageCount        Int?
  rawPages         Json?
  extractedJson    Json?
  validationErrors Json?
  status           CurriculumImportStatus @default(UPLOADED)
  errorMessage     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  CurriculumTopic[]

  @@index([subjectId, classLevel])
}

model CurriculumTopic {
  id         String     @id @default(cuid())
  subjectId  String
  classLevel ClassLevel
  importId   String?

  theme                     String
  learningOutcome           String
  focalCompetence           String
  topic                     String
  performanceObjectives     Json
  content                   Json
  keyCompetenciesAndValues  Json
  learningActivities        Json
  teachingLearningResources Json
  evaluationGuide           Json
  sourcePage                Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  import  CurriculumImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  tutorSessions  TutorSession[]
  studentMastery StudentMastery[]

  @@unique([subjectId, classLevel, theme, topic])
  @@index([subjectId, classLevel])
}

model TutorSession {
  id               String      @id @default(cuid())
  userId           String
  subjectId        String
  classLevel       ClassLevel
  topicId          String
  state            LessonState @default(INTRODUCTION)
  masteryAtStart   Int?
  weakAreasAtStart Json?
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic    CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  messages TutorMessage[]

  @@index([userId, subjectId, classLevel])
}

model TutorMessage {
  id        String            @id @default(cuid())
  sessionId String
  role      TutorMessageRole
  content   String
  blocks    Json?
  stateAt   LessonState

  createdAt DateTime @default(now())

  session TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model StudentMastery {
  id            String     @id @default(cuid())
  userId        String
  subjectId     String
  classLevel    ClassLevel
  topicId       String
  masteryScore  Int        @default(0)
  weakAreas     Json?
  lastStudiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, subjectId, classLevel])
}

model Question {
  id              String         @id @default(cuid())
  subjectId       String
  classLevel      ClassLevel
  /// A human-readable topic name within the subject (e.g. "Algebra",
  /// "Quadratic Equations") - freeform, not a foreign key into
  /// CurriculumTopic (that table is keyed to imported curriculum PDFs and
  /// doesn't cover every subject; this is independently tagged on the
  /// question bank so Challenges can select/weight by topic). Nullable
  /// for now since older seeded questions predate this field.
  topic           String?
  questionText    String
  explanation     String?
  difficulty      Int            @default(1)
  correctAnswerId String

  /// The exam body this question was sourced from (WAEC/JAMB/NECO past
  /// question), when known. Null for hand-authored/AI-generated questions
  /// with no exam provenance.
  examType        ExamType?
  /// The year the source exam was sat, when known.
  examYear        Int?

  /// Existing questions are PUBLISHED; new ones authored in the admin start as DRAFT.
  status          QuestionStatus @default(PUBLISHED)
  updatedAt       DateTime       @updatedAt

  subject         Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  options         AnswerOption[]

  createdAt       DateTime       @default(now())

  @@index([subjectId, classLevel])
  @@index([subjectId, topic])
  @@index([subjectId, examType, examYear])
  @@index([subjectId, classLevel, status])
}

/// An async 1v1 "Challenges" match: player A picks topics within a
/// subject, player B (independently) picks their own topics, and
/// EduQuest builds one combined question set weighted toward topics
/// both chose. Both players see the same questions but each gets their
/// own randomized option order (`challengerOptionOrder` /
/// `opponentOptionOrder`), so neither can just tell the other "it's
/// option B". Players don't need to be online together - either can
/// answer whenever once the challenge is ACTIVE, and results are only
/// revealed once both have submitted.
model Challenge {
  id         String          @id @default(cuid())
  subjectId  String
  classLevel ClassLevel

  challengerId String
  opponentId   String

  /// string[] of topic names the challenger picked when creating this.
  challengerTopics Json
  /// string[] of topic names the opponent picked - null until they
  /// respond (PENDING -> ACTIVE transition).
  opponentTopics   Json?

  status ChallengeStatus @default(PENDING)

  /// string[] of Question ids - the frozen, weighted-and-shuffled pool
  /// both players answer. Set once, when the challenge goes ACTIVE.
  questionIds String[]

  /// { [questionId]: string[] } - that question's AnswerOption ids in
  /// the order shown to this player. Independently randomized per
  /// player per question.
  challengerOptionOrder Json?
  opponentOptionOrder   Json?

  /// { [questionId]: selectedOptionId } - only ever written by grading
  /// the submission server-side; never trusted from a client-reported
  /// score.
  challengerAnswers Json?
  opponentAnswers   Json?

  challengerScore Int?
  opponentScore   Int?

  challengerCompletedAt DateTime?
  opponentCompletedAt   DateTime?

  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  completedAt DateTime?

  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  challenger User    @relation("ChallengesSent", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User    @relation("ChallengesReceived", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([challengerId, status])
  @@index([opponentId, status])
}

/// A student's running accuracy in one subject, updated on every graded
/// answer batch (a regular quiz submission or a Challenge submission).
/// Distinct from `User.accuracy` (a single global rolling number across
/// every subject) - this is what Challenge matchmaking uses to find
/// opponents of similar *subject-specific* ability, since someone can be
/// strong in one subject and weak in another regardless of overall
/// level.
model SubjectStat {
  id                String   @id @default(cuid())
  userId            String
  subjectId         String
  questionsAnswered Int      @default(0)
  correctAnswers    Int      @default(0)
  lastActiveAt      DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([subjectId])
  @@index([subjectId, correctAnswers])
}

model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  text       String

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

/// Essay/theory-style past exam questions (e.g. WAEC Paper 2), as opposed to
/// the multiple-choice bank in Question. These have no discrete correct
/// option - instead they carry the chief examiner's own commentary
/// (observation/generalComments/weaknessesRemedies/strengths), which is
/// useful as grading rubric context for an AI grader assessing a student's
/// free-text response, not as a single "correct answer".
model TheoryQuestion {
  id                 String     @id @default(cuid())
  subjectId          String
  classLevel         ClassLevel @default(SS3)
  topic              String?
  questionText       String

  examType           ExamType?
  examYear           Int?
  /// Free-text paper label as published by the exam body (e.g. "Paper 2"),
  /// not always present depending on source template.
  paper              String?

  observation        String?
  generalComments    String?
  weaknessesRemedies String?
  strengths          String?
  imageUrls          String[]   @default([])

  subject            Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt          DateTime   @default(now())

  @@index([subjectId, classLevel])
  @@index([subjectId, examType, examYear])
}
